{
  "name": "agy-hub",
  "version": "1.2.3",
  "description": "AGY Hub 桌面管家：管理 Antigravity 汉化注入、账号额度、Codex/Claude Desktop 接入与本地反向代理。",
  "author": "niu1029",
  "homepage": "https://github.com/3169657175/Antigravity-Chinese",
  "main": "main.js",
  "license": "MIT",
  "scripts": {
    "dist:sync": "electron-builder && node scripts/sync-d.js",
    "patch:rebuild": "node patch-workbench/build-patch.js",
    "patch:verify": "node patch-workbench/verify-patch.js",
    "test:token-usage": "node --test tests/tokenUsage.test.js",
    "test:codex-gateway": "node --test tests/codexGateway.test.js",
    "test:codex-lifecycle": "node --test tests/codexAppLifecycle.test.js",
    "test": "node --test tests/*.test.js",
    "test:architecture": "node --test tests/architectureBoundaries.test.js tests/navigationPerformance.test.js tests/runtimeDeps.test.js"
  },
  "build": {
    "appId": "com.agy.hub",
    "publish": [
      {
        "provider": "github",
        "owner": "3169657175",
        "repo": "Antigravity-Chinese"
      }
    ],
    "files": [
      "package.json",
      "LICENSE",
      "index.html",
      "style.css",
      "styles/**/*",
      "src/**/*.js",
      "assets/icon.ico",
      "assets/logo-*.png",
      "assets/logo.svg",
      "assets/themes/**/*",
      "main.js",
      "preload.js",
      "renderer.js",
      "patch-workbench/compatibility.js"
    ],
    "productName": "AGY Hub 桌面管家",
    "directories": {
      "output": "dist"
    },
    "extraResources": [
      {
        "from": "assets/app.asar",
        "to": "patch/app.asar"
      },
      {
        "from": "assets/patch-manifest.json",
        "to": "patch/patch-manifest.json"
      },
      {
        "from": "patch-workbench/legacy-payload.asar",
        "to": "patch/legacy-payload.asar"
      },
      {
        "from": "patch-workbench/runtime-rules.json",
        "to": "patch/runtime-rules.json"
      }
    ],
    "win": {
      "icon": "assets/icon.ico",
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "artifactName": "agy-hub-setup-${version}.${ext}",
      "installerIcon": "assets/icon.ico",
      "uninstallerIcon": "assets/icon.ico",
      "installerHeaderIcon": "assets/icon.ico",
      "shortcutName": "AGY Hub 桌面管家",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "include": "build/installer.nsh",
      "runAfterFinish": true
    }
  },
  "dependencies": {
    "@electron/asar": "^3.4.1",
    "electron-updater": "^6.8.9",
    "https-proxy-agent": "^5.0.1"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^26.15.3"
  }
}
