{
  "name": "agy-hub",
  "version": "1.4.1",
  "description": "AGY Hub 桌面管家：管理 Antigravity 汉化注入、账号额度、Codex / 自定义 Provider 接入、本地反向代理、社区与自动更新。",
  "author": "niu1029",
  "homepage": "https://github.com/3169657175/Antigravity-Chinese",
  "main": "main.js",
  "license": "MIT",
  "scripts": {
    "dist:sync": "npm run release:build && node sync-d.js",
    "patch:rebuild": "node patch-workbench/build-patch.js",
    "patch:verify": "node patch-workbench/verify-patch.js",
    "localization:audit": "node patch-workbench/audit-localization.js",
    "test:token-usage": "node --test tests/unit/tokenUsage.test.js",
    "test:codex-gateway": "node --test tests/unit/codexGateway.test.js",
    "test:codex-lifecycle": "node --test tests/unit/codexAppLifecycle.test.js",
    "test": "node --test tests/unit/*.test.js",
    "test:architecture": "node --test tests/unit/architectureBoundaries.test.js tests/unit/navigationPerformance.test.js tests/unit/runtimeDeps.test.js",
    "test:installer-upgrade": "node scripts/smoke/smoke-installer-upgrade.cjs",
    "test:packaged-patch": "node scripts/smoke/smoke-packaged-patch.cjs",
    "test:translation-dom": "node scripts/smoke/smoke-translation-dom.cjs",
    "release:verify": "node releaseGuard.js",
    "release:build": "npm run patch:rebuild && npm run patch:verify && npm test && npm run test:installer-upgrade && node releaseGuard.js && electron-builder --win nsis --publish never && node releaseGuard.js --artifacts && npm run test:packaged-patch && npm run test:translation-dom -- --packaged"
  },
  "build": {
    "beforePack": "build/preparePatchResources.cjs",
    "appId": "com.agy.hub",
    "publish": [
      {
        "provider": "github",
        "owner": "3169657175",
        "repo": "Antigravity-Chinese"
      }
    ],
    "files": [
      "package.json",
      "LICENSE",
      "index.html",
      "style.css",
      "accountUi.css",
      "gatewayUi.css",
      "marketplace/**/*",
      "assets/icon.ico",
      "assets/logo-*.png",
      "assets/logo.svg",
      "assets/themes/**/*",
      "accountErrorClassifier.js",
      "accountIpc.js",
      "accountQuota.js",
      "antigravityQuotaBridge.js",
      "accountUi.js",
      "anthropicGateway.js",
      "appShutdown.js",
      "appShellController.js",
      "brainMonitor.js",
      "claudeDesktopConfig.js",
      "claudeDesktopLifecycle.js",
      "claudeModelRoutes.js",
      "codexAppLifecycle.js",
      "codexConfig.js",
      "codexGateway.js",
      "codexModels.js",
      "codexProviderProfiles.js",
      "communityClient.js",
      "communityController.js",
      "communityIpc.js",
      "communityMedia.js",
      "configSnapshotStore.js",
      "customContextBudget.js",
      "fsUtils.js",
      "gatewayConfigStore.js",
      "gatewayController.js",
      "gatewayDiagnostics.js",
      "gatewayHttp.js",
      "gatewayIpc.js",
      "gatewayCompatibilityController.js",
      "inboundProtocolAdapters.js",
      "gatewayProfiles.js",
      "gatewayTestRunner.js",
      "gatewayUi.js",
      "localAccountsController.js",
      "logTailReader.js",
      "localApiCapabilities.js",
      "main.js",
      "marketplaceController.js",
      "mcpLaunchConfig.js",
      "mcpProbe.js",
      "navigationController.js",
      "onboardingController.js",
      "operationFeedback.js",
      "providerProtocol.js",
      "providerHealthStore.js",
      "patchBackupManager.js",
      "patchController.js",
      "patchRuntimeBuilder.js",
      "patchVersionInfo.js",
      "archiveReadIsolation.js",
      "antigravityInstallMonitor.js",
      "patchResourceResolver.js",
      "patchWorker.js",
      "patch-workbench/compatibility.js",
      "patch-workbench/localization.js",
      "patch-workbench/audit-localization.js",
      "patch-workbench/locales/zh-CN.json",
      "patch-workbench/injections/translation-enhancement.js",
      "patch-workbench/injections/native-localization.js",
      "preload.js",
      "proxy.js",
      "renderer.js",
      "responsesRequestAdapter.js",
      "retryPolicy.js",
      "safeDom.js",
      "secretCodec.js",
      "skillCatalogRemote.js",
      "skillTranslationService.js",
      "skillTranslationStore.js",
      "themeController.js",
      "themeIpc.js",
      "tokenMonitorController.js",
      "tokenStatsStore.js",
      "tokenUsage.js",
      "translationCatalog.js",
      "updaterService.js",
      "updateUtils.js",
      "urlPolicy.js",
      "antigravityModelCatalog.js",
      "communityData.js",
      "adminCommunityController.js",
      "uiFeedback.js",
      "featureFlags.js",
      "communityState.js",
      "styles/community.css",
      "releaseConfig.js",
      "pageLifecycle.js",
      "errorDiagnostics.js",
      "releaseGuard.js"
    ],
    "productName": "AGY Hub 桌面管家",
    "directories": {
      "output": "dist"
    },
    "extraResources": [
      {
        "from": "build/generated/accountQuota.js",
        "to": "patch/accountQuota.js"
      },
      {
        "from": "build/generated/antigravityQuotaBridge.js",
        "to": "patch/antigravityQuotaBridge.js"
      },
      {
        "from": "patch-workbench/injections/native-localization.js",
        "to": "patch/native-localization.js"
      },
      {
        "from": "patch-workbench/injections/translation-enhancement.js",
        "to": "patch/translation-enhancement.js"
      },
      {
        "from": "patch-workbench/locales/zh-CN.json",
        "to": "patch/zh-CN.json"
      },
      {
        "from": "assets/app.asar",
        "to": "patch/app.asar"
      },
      {
        "from": "assets/patch-manifest.json",
        "to": "patch/patch-manifest.json"
      },
      {
        "from": "patch-workbench/legacy-payload.asar",
        "to": "patch/legacy-payload.asar"
      },
      {
        "from": "patch-workbench/runtime-rules.json",
        "to": "patch/runtime-rules.json"
      }
    ],
    "win": {
      "icon": "assets/icon.ico",
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "artifactName": "agy-hub-setup-${version}.${ext}",
      "installerIcon": "assets/icon.ico",
      "uninstallerIcon": "assets/icon.ico",
      "installerHeaderIcon": "assets/icon.ico",
      "shortcutName": "AGY Hub 桌面管家",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "include": "build/installer.nsh",
      "runAfterFinish": true
    }
  },
  "dependencies": {
    "@electron/asar": "^3.4.1",
    "electron-updater": "^6.8.9",
    "https-proxy-agent": "^5.0.1"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^26.15.3"
  }
}
